<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar ONDA" Width="1040" Height="660" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#10151E" Foreground="#EDF5F5" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Mint" Color="#79E2C4"/>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#EDF5F5"/><Setter Property="Background" Value="#1A252E"/><Setter Property="Padding" Value="10,7"/>
      <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#31524F"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="#1A252E" BorderBrush="#40555F" BorderThickness="1" CornerRadius="7">
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B5C7CE" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
              </Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="10,0,26,0"/>
          <Popup IsOpen="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#1A252E" BorderBrush="#40555F" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Margin="3"/>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF5F5"/>
      <Setter Property="Background" Value="#25323D"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.83"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="White"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111A23"/><Setter Property="Foreground" Value="#EDF5F5"/>
      <Setter Property="BorderBrush" Value="#3B515A"/><Setter Property="CaretBrush" Value="#79E2C4"/>
      <Setter Property="Padding" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#408C7C"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Switch" Width="44" Height="25" CornerRadius="13" Background="#435760" Margin="0,0,12,0">
            <Ellipse x:Name="Thumb" Width="19" Height="19" Fill="#EDF5F5" HorizontalAlignment="Left" Margin="3"/>
          </Border>
          <ContentPresenter VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#79E2C4"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="White"/><Setter TargetName="Switch" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#34454D" BorderThickness="1" CornerRadius="22" Padding="32,20,32,24">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#101B23" Offset="0"/><GradientStop Color="#10151E" Offset="0.65"/><GradientStop Color="#10232A" Offset="1"/>
    </LinearGradientBrush></Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="ONDA" FontSize="24" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <Border Background="#1D3238" CornerRadius="6" Padding="9,4" VerticalAlignment="Center">
            <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Mint}" Text="1.2.0"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <TextBlock x:Name="LanguageLabel" Text="Idioma" Foreground="#B5C7CE" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="LanguagePicker" Width="158" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#EDF5F5" AutomationProperties.Name="Idioma">
            <ComboBoxItem Tag="pt-BR" Content="Português (Brasil)"/>
            <ComboBoxItem Tag="es" Content="Español"/>
            <ComboBoxItem Tag="en" Content="English"/>
          </ComboBox>
          <Button x:Name="MinimizeButton" Content="−" FontSize="22" Padding="12,2" Background="Transparent" AutomationProperties.Name="Minimizar instalador"/>
          <Button x:Name="CloseButton" Content="×" FontSize="24" Padding="12,0" Background="Transparent" AutomationProperties.Name="Fechar instalador"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,24,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Grid Margin="0,22,32,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock FontSize="48" FontWeight="SemiBold" LineHeight="55" TextWrapping="Wrap">
            <Run x:Name="HeroPrefix" Text="Sua ONDA"/><LineBreak/><Run x:Name="HeroSuffix" Text="começa aqui." Foreground="{StaticResource Mint}"/>
          </TextBlock>
          <TextBlock x:Name="Subtitle" Grid.Row="1" Margin="0,20,0,0" Foreground="#AEBEC6" TextWrapping="Wrap" FontSize="16" LineHeight="24" Text="Músicas, vídeos e imagens do seu jeito."/>
          <Viewbox Grid.Row="2" Stretch="Uniform" Margin="-12,20,-12,4" VerticalAlignment="Center">
            <Canvas Width="440" Height="190" ClipToBounds="True">
              <Path Stroke="#143D3F" StrokeThickness="1.4" Data="M -10,130 C 55,30 85,165 150,92 S 245,25 290,112 S 390,160 450,95"/>
              <Path Stroke="#215A55" StrokeThickness="1.5" Data="M -10,123 C 55,23 85,158 150,85 S 245,18 290,105 S 390,153 450,88"/>
              <Path Stroke="#317E71" StrokeThickness="1.5" Data="M -10,116 C 55,16 85,151 150,78 S 245,11 290,98 S 390,146 450,81"/>
              <Path Stroke="#4AA990" StrokeThickness="1.6" Data="M -10,109 C 55,9 85,144 150,71 S 245,4 290,91 S 390,139 450,74"/>
              <Path Stroke="#79E2C4" StrokeThickness="2.5" Data="M -10,102 C 55,2 85,137 150,64 S 245,-3 290,84 S 390,132 450,67"/>
              <Path Stroke="#52B49C" StrokeThickness="1.5" Data="M -10,95 C 55,-5 85,130 150,57 S 245,-10 290,77 S 390,125 450,60"/>
              <Path Stroke="#328477" StrokeThickness="1.5" Data="M -10,88 C 55,-12 85,123 150,50 S 245,-17 290,70 S 390,118 450,53"/>
              <Path Stroke="#225B57" StrokeThickness="1.4" Data="M -10,81 C 55,-19 85,116 150,43 S 245,-24 290,63 S 390,111 450,46"/>
            </Canvas>
          </Viewbox>
        </Grid>
        <Border Grid.Column="1" Background="#1A252E" BorderBrush="#30434B" BorderThickness="1" CornerRadius="22" Padding="28" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="430">
            <StackPanel>
              <TextBlock x:Name="PageHeading" Text="Vamos instalar?" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,22"/>
              <StackPanel x:Name="OptionsPanel">
                <Label x:Name="DestinationLabel" Target="{Binding ElementName=DestinationBox}" Content="Onde instalar" Foreground="#EDF5F5" Padding="0,0,0,8"/>
                <DockPanel LastChildFill="True">
                  <Button x:Name="BrowseButton" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" AutomationProperties.Name="Escolher pasta de instalação">
                    <Path Width="21" Height="18" Stretch="Uniform" Stroke="#B5C7CE" StrokeThickness="1.5" Data="M 1,5 L 1,2 Q 1,1 2,1 L 8,1 L 10,4 L 19,4 Q 21,4 21,6 L 21,16 Q 21,18 19,18 L 3,18 Q 1,18 1,16 Z"/>
                  </Button>
                  <TextBox x:Name="DestinationBox" AutomationProperties.Name="Pasta de instalação"/>
                </DockPanel>
                <CheckBox x:Name="ShortcutBox" Content="Atalho na área de trabalho" Foreground="#EDF5F5" IsChecked="True" Margin="0,22,0,16" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="PlatformLabel" Text="Windows x64 · Instalação por usuário" Foreground="#9EB2BD" FontSize="12" Margin="0,0,0,22" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,18">
                <TextBlock x:Name="ProgressText" Text="Preparando os arquivos…" TextWrapping="Wrap" Foreground="#B5C7CE" Margin="0,0,0,16"/>
                <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource Mint}" Background="#33434D"/>
                <TextBlock x:Name="PercentLabel" Text="0%" Foreground="{StaticResource Mint}" Margin="0,12,0,0"/>
              </StackPanel>
              <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" Foreground="#B8C9CF" LineHeight="22" Margin="0,0,0,16" Visibility="Collapsed"/>
              <Button x:Name="InstallButton" Background="{StaticResource Mint}" Foreground="#0D2824" Padding="16,15" FontSize="17" FontWeight="SemiBold" Content="Instalar ONDA  →" IsDefault="True"/>
              <Button x:Name="DetailsButton" Content="Ver detalhes" Foreground="{StaticResource Mint}" Background="Transparent" Padding="12,10" Margin="0,4,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="Footnote" Text="Gratuito, de código aberto e sem anúncios." Foreground="#9EB2BD" FontSize="12" TextAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="ConfigureStep" Text="●  Configurar" Foreground="{StaticResource Mint}"/>
        <TextBlock Text="  ─────  " Foreground="#40555F"/>
        <TextBlock x:Name="InstallStep" Text="○  Instalar" Foreground="#91A5AE"/>
        <TextBlock Text="  ─────  " Foreground="#40555F"/>
        <TextBlock x:Name="CompleteStep" Text="○  Concluir" Foreground="#91A5AE"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
